float scrollY = 0;
int totalHeight = 900;  // 3 days x 300 pixels, increase as you add days

void setup() {
  size(500, 600);
}

void draw() {
  background(245);
  fill(30);

  translate(0, -scrollY);  // shift everything by the scroll amount

  drawMonday(0);
  drawTuesday(300);
  drawWednesday(600);
  drawThursday(900); 
  drawFriday(1200);
  drawSaturday(1500);
  drawSunday(1800);
  drawMonday2(2100);
  drawMonday3(2400);
  drawWednesday2(2700);
  drawThrusday2(3000);
  drawThrusday3(3300);
  drawFriday2(3600);
  drawFriday3(3900);
  drawSaturday2(4200);
  drawSunday2(4500);
  drawSunday3(4800);
  drawSunday4(5100);
  drawSunday5(5400);
  drawSunday6(5700);
  drawMonday4(6000);
  drawMonday5(6300);
  drawTuesday4(6600);
  drawTuesday5(6900);


}

void mouseWheel(MouseEvent event) {
  scrollY += event.getCount() * 20;               // 20 = scroll speed
  scrollY = constrain(scrollY, 0, totalHeight - height);  // stop at top and bottom
}

